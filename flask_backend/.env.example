# Bu dosyayı `.env` olarak kopyalayıp değerleri düzenleyin.

# --- Sunucu ---
HOST=0.0.0.0
PORT=5454
DEBUG=false

# --- Veri kaynağı ---
# true  -> her zaman örnek (mock) veri (ağ gerektirmez, demo için ideal)
# false -> gerçek market sitelerinden scraping yapılır
USE_MOCK=true
# Gerçek scraping başarısız olursa örnek veriye düş
MOCK_FALLBACK=true

# --- Scraping ---
REQUEST_TIMEOUT=10
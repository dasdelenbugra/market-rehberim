# Bu dosyayı `.env` olarak kopyalayıp değerleri düzenleyin.

# --- Sunucu ---
HOST=0.0.0.0
PORT=5454
DEBUG=false

# --- Veri kaynağı ---
# true  -> her zaman örnek (mock) veri (ağ gerektirmez, demo için ideal)
# false -> gerçek kaynak (marketfiyati.org.tr) kullanılır
USE_MOCK=true
# Gerçek kaynak başarısız olursa örnek veriye düş
MOCK_FALLBACK=true

# --- Ulusal fiyat kaynağı (marketfiyati.org.tr / TÜBİTAK BİLGEM) ---
# Ayrıntı ve hukuki gerekçe: docs/VERI_KAYNAGI.md
MARKETFIYATI_BASE_URL=https://api.marketfiyati.org.tr/api/v2
# Şehir merkezinden kaç km yarıçapındaki şubeler taransın
MARKETFIYATI_DISTANCE_KM=15
MARKETFIYATI_PAGE_SIZE=24

# Ulusal sonuçların önbellek ömrü (saniye). Kaynak günlük tazeleniyor.
SEARCH_CACHE_TTL=21600

# --- Eski doğrudan scraping (VARSAYILAN KAPALI) ---
# Market sitelerini doğrudan kazımak hukuki risk taşır; üretimde açmayın.
ENABLE_LEGACY_SCRAPERS=false

# --- HTTP ---
REQUEST_TIMEOUT=10
CLIENT_USER_AGENT=MarketRehberim/1.0 (+iletisim: uygulama-sahibi@ornek.com)

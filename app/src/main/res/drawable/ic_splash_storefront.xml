<?xml version="1.0" encoding="utf-8"?>
<!-- Açılış ikonu: derinlikli (sahte-3B) market vitrini.

     Düz beyaz silüet yerine katmanlı sahne: arka ışık halkası, zemin gölgesi,
     çatı/yan yüzeyli ekstrüde bina, degradeli tente ve içi aydınlık vitrin.
     Derinlik tamamen degrade + katman sırasıyla kurulur; bitmap yok, her
     yoğunlukta keskin. Grup/yol adları splash_icon.xml'deki animasyon
     hedefleridir — yeniden adlandırırken ikisini birlikte değiştir. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:name="icon"
        android:pivotX="54"
        android:pivotY="54">

        <!-- Arka ışık halkası: ikonu düz yeşil zeminden kaldırır -->
        <path
            android:name="glow"
            android:pathData="M20,52 a34,34 0 1 0 68,0 a34,34 0 1 0 -68,0 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="54"
                    android:centerY="52"
                    android:gradientRadius="34"
                    android:type="radial">
                    <item android:color="#24FFFFFF" android:offset="0.0" />
                    <item android:color="#10FFFFFF" android:offset="0.55" />
                    <item android:color="#00FFFFFF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Zemin gölgesi: bina yere bassın, boşlukta yüzmesin -->
        <path
            android:name="shadow"
            android:fillColor="#2E00320D"
            android:pathData="M33,77.5 a21,3.8 0 1 0 42,0 a21,3.8 0 1 0 -42,0 z" />

        <!-- Bina: çatı üstü + sağ yan yüz + ön yüz (ekstrüzyon) -->
        <path
            android:pathData="M32,46 L38,40 H78 L72,46 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="55" android:startY="40"
                    android:endX="55" android:endY="46"
                    android:type="linear">
                    <item android:color="#FFFFFDF6" android:offset="0.0" />
                    <item android:color="#FFEFE2CB" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M72,46 L78,40 V68 L72,74 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="75" android:startY="40"
                    android:endX="75" android:endY="74"
                    android:type="linear">
                    <item android:color="#FFE0CBAC" android:offset="0.0" />
                    <item android:color="#FFC3A87F" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:pathData="M32,46 H72 V71 a3,3 0 0 1 -3,3 H35 a3,3 0 0 1 -3,-3 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="52" android:startY="46"
                    android:endX="52" android:endY="74"
                    android:type="linear">
                    <item android:color="#FFFFF7EA" android:offset="0.0" />
                    <item android:color="#FFEDD9BE" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Kapı (kemerli) + topuz -->
        <path
            android:pathData="M39,74 V63 a5.5,5.5 0 0 1 11,0 V74 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="44.5" android:startY="57.5"
                    android:endX="44.5" android:endY="74"
                    android:type="linear">
                    <item android:color="#FF2E7D32" android:offset="0.0" />
                    <item android:color="#FF134D21" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#FFE9B85C"
            android:pathData="M48.9,66.5 a0.9,0.9 0 1 1 -1.8,0 a0.9,0.9 0 1 1 1.8,0 z" />

        <!-- Vitrin: beyaz çerçeve + içi aydınlık cam ("dükkân açık") -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M56.5,57.5 h11 a1.5,1.5 0 0 1 1.5,1.5 v8 a1.5,1.5 0 0 1 -1.5,1.5 h-11 a1.5,1.5 0 0 1 -1.5,-1.5 v-8 a1.5,1.5 0 0 1 1.5,-1.5 z" />
        <path
            android:name="glass"
            android:pathData="M57,58.7 h10 a0.8,0.8 0 0 1 0.8,0.8 v6.6 a0.8,0.8 0 0 1 -0.8,0.8 h-10 a0.8,0.8 0 0 1 -0.8,-0.8 v-6.6 a0.8,0.8 0 0 1 0.8,-0.8 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="62" android:startY="58.7"
                    android:endX="62" android:endY="67"
                    android:type="linear">
                    <item android:color="#FFFFEFC0" android:offset="0.0" />
                    <item android:color="#FFF0CB74" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Tente: koyu bar + 6 fistolu şerit (yeşil/beyaz).
             Pivot barın üstünde — animasyonda yukarıdan "açılır". -->
        <group
            android:name="awning"
            android:pivotX="53"
            android:pivotY="43">
            <path
                android:fillColor="#FF10451E"
                android:pathData="M28,43 h50 v3 h-50 z" />
            <path android:pathData="M28,46 h8.34 v8 a4.17,4 0 0 1 -8.34,0 z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="32" android:startY="46"
                        android:endX="32" android:endY="58"
                        android:type="linear">
                        <item android:color="#FF4CAF50" android:offset="0.0" />
                        <item android:color="#FF1E7A2E" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:pathData="M36.34,46 h8.33 v8 a4.16,4 0 0 1 -8.33,0 z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="40.5" android:startY="46"
                        android:endX="40.5" android:endY="58"
                        android:type="linear">
                        <item android:color="#FFFFFFFF" android:offset="0.0" />
                        <item android:color="#FFD8E2D4" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:pathData="M44.67,46 h8.33 v8 a4.16,4 0 0 1 -8.33,0 z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="48.8" android:startY="46"
                        android:endX="48.8" android:endY="58"
                        android:type="linear">
                        <item android:color="#FF4CAF50" android:offset="0.0" />
                        <item android:color="#FF1E7A2E" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:pathData="M53,46 h8.33 v8 a4.16,4 0 0 1 -8.33,0 z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="57.2" android:startY="46"
                        android:endX="57.2" android:endY="58"
                        android:type="linear">
                        <item android:color="#FFFFFFFF" android:offset="0.0" />
                        <item android:color="#FFD8E2D4" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:pathData="M61.33,46 h8.33 v8 a4.16,4 0 0 1 -8.33,0 z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="65.5" android:startY="46"
                        android:endX="65.5" android:endY="58"
                        android:type="linear">
                        <item android:color="#FF4CAF50" android:offset="0.0" />
                        <item android:color="#FF1E7A2E" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>
            <path android:pathData="M69.66,46 h8.34 v8 a4.17,4 0 0 1 -8.34,0 z">
                <aapt:attr name="android:fillColor">
                    <gradient
                        android:startX="73.8" android:startY="46"
                        android:endX="73.8" android:endY="58"
                        android:type="linear">
                        <item android:color="#FFFFFFFF" android:offset="0.0" />
                        <item android:color="#FFD8E2D4" android:offset="1.0" />
                    </gradient>
                </aapt:attr>
            </path>
        </group>
    </group>
</vector>

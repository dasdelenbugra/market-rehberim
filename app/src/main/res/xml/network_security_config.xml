<?xml version="1.0" encoding="utf-8"?>
<!--
  Üretimde tüm trafik HTTPS olmalıdır (bulut backend https sağlar). Şifresiz (cleartext)
  trafiğe yalnızca yerel geliştirme adreslerinde izin verilir: emülatörden host makineye
  erişim (10.0.2.2), localhost ve gerçek cihazdan aynı Wi-Fi üzerindeki geliştirme
  makinesine erişim (yerel ağ IP'si).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Gerçek cihazla test edecekseniz geliştirme makinesinin o anki Wi-Fi
             IP'sini buraya bir <domain> satırı olarak ekleyin ve aynı adresi
             local.properties → backend.baseUrl alanına yazın. İki yer de
             güncellenmezse istek TLS hatasıyla değil, sessizce başarısız olur.
             Sabit bir IP bırakmıyoruz: ağ değişince ölü kural olarak kalıyor. -->
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>

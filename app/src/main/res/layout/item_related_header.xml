<?xml version="1.0" encoding="utf-8"?>
<!-- "İlgili ürünler (17)" — sorgunun asıl hedefi olmayan sonuçları ayıran,
     dokunulunca açılıp kapanan başlık. Varsayılan kapalı: bu ürünlerin asıl
     sonuçlara karışması kullanıcının şikâyetiydi. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/headerRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="14dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvRelatedTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="İlgili ürünler (17)" />

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_expand_more"
        app:tint="?attr/colorOnSurfaceVariant"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>

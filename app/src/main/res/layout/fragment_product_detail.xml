<?xml version="1.0" encoding="utf-8"?>
<!--
  Ürün detayı.

  Görselin üzerinde yüzen geri ve favori butonları: ekranın artık kendi çıkışı var
  (önceden tek çıkış sistem geri tuşuydu) ve favori tam genişlik bir butonu işgal
  etmiyor. Alt sabit çubuk detayı sepet akışına bağlar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    tools:context=".ui.view.detail.ProductDetailFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Tam genişlik görsel; fitCenter ürün etiketini kesmez -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:background="?attr/colorSurfaceContainerHighest"
                    android:contentDescription="@string/item_image_desc"
                    android:padding="24dp"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_margin">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/name"
                        style="@style/TextAppearance.MarketRehberim.ScreenTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="Sütaş Günlük Süt 1 lt" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/marketDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/shape_market_dot"
                            tools:backgroundTint="@color/market_sok" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/from"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="ŞOK" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceDisplaySmall"
                            android:textColor="?attr/colorTertiary"
                            android:textStyle="bold"
                            tools:text="38,50 ₺" />

                        <!-- Birim fiyat, paket fiyatının hemen yanında -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvUnitPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="8dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone"
                            tools:text="112,50 ₺/L"
                            tools:visibility="visible" />

                        <!-- En pahalı alternatife göre kazanç, fiyatın yanında -->
                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tvSaving"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="6dp"
                            android:background="@drawable/bg_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:text="6,25 ₺ daha ucuz"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <!-- Marketlerde karşılaştırma -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvCompareTitle"
                        style="@style/TextAppearance.MarketRehberim.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/in_markets"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/compareCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp"
                        tools:visibility="visible">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/compareList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            tools:listitem="@layout/item_compare" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Fiyat geçmişi -->
                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.MarketRehberim.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/price_history" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <!-- Geçmiş henüz birikmediyse grafiğin yerine bu geçer.
                                 Boş bir kutu bırakmak yerine neden boş olduğunu söyler. -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvHistoryEmpty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingVertical="18dp"
                                android:text="@string/history_empty"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:visibility="gone"
                                tools:visibility="gone" />

                            <!-- İlk kayıttan son kayda değişim. Rengi kodda
                                 belirlenir: ucuzlama yeşil, zam kırmızı. -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvTrend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textStyle="bold"
                                android:visibility="gone"
                                tools:text="↓ %8,2 ucuzladı"
                                tools:visibility="visible" />

                            <!-- Yükseklik 160 -> 180: alt şeridi artık tarih
                                 etiketleri kullanıyor, çizim alanı kısalmasın. -->
                            <com.marketrehberim.ui.widget.LineChartView
                                android:id="@+id/chart"
                                android:layout_width="match_parent"
                                android:layout_height="180dp"
                                android:focusable="true" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvChartHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/chart_hint"
                                android:textAppearance="?attr/textAppearanceLabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant" />

                            <LinearLayout
                                android:id="@+id/historyRange"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tvMin"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="monospace"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorPrimary"
                                    tools:text="En düşük: 36,90 ₺" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tvMax"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="monospace"
                                    android:gravity="end"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    tools:text="En yüksek: 44,75 ₺" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Görselin üzerinde yüzen eylemler -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:contentDescription="@string/back"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="?attr/colorSurfaceContainerLowest"
            app:cornerRadius="21dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFavorite"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:layout_margin="14dp"
            android:contentDescription="@string/favorite"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="?attr/colorSurfaceContainerLowest"
            app:cornerRadius="21dp"
            app:icon="@drawable/ic_favorite_border"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorTertiary" />
    </FrameLayout>

    <!-- Alt sabit çubuk: detay ile sepet akışı arasındaki kopukluğu kapatır -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToBasket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:text="@string/add_to_basket"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_basket_outlined"
            app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>

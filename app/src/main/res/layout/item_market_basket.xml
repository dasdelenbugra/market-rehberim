<?xml version="1.0" encoding="utf-8"?>
<!--
  Tek markette sepet toplamı. Eksik ürünü olan market listeden atılmaz, soluk
  gösterilir ve kapsamı (3/4) yazılır — kararı kullanıcı verir.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <View
            android:id="@+id/marketDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_market_dot"
            tools:backgroundTint="@color/market_sok" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/market"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="ŞOK" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/coverage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="4 / 4 ürün bulundu" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/total"
            style="@style/TextAppearance.MarketRehberim.Price.Large"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            tools:text="251,40 ₺" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

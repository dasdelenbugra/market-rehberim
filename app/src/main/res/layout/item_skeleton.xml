<?xml version="1.0" encoding="utf-8"?>
<!--
  Yükleniyor durumundaki sahte sonuç satırı. Ortada dönen bir çarkın aksine
  gelecek düzeni önden gösterir; bekleme daha kısa hissettirir.
  Ölçüler item_layout.xml ile birebir aynı olmalı, yoksa sonuçlar gelince
  liste zıplar.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/skeletonCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <View
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_skeleton" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:background="@drawable/bg_skeleton" />

            <View
                android:layout_width="120dp"
                android:layout_height="12dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_skeleton" />
        </LinearLayout>

        <View
            android:layout_width="64dp"
            android:layout_height="18dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_skeleton" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
